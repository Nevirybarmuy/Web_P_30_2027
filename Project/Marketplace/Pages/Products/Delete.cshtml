@page "{id:int}"
@model Marketplace.Pages.Products.DeleteModel
@{
    ViewData["Title"] = "Удалить товар";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card p-4">
            <h3 class="fw-bold mb-3 text-danger">Удалить товар?</h3>
            <p>Вы уверены, что хотите удалить <strong>@Model.Product?.Name</strong>?</p>
            <form method="post">
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger">Удалить</button>
                    <a href="/Products" class="btn btn-outline-secondary">Отмена</a>
                </div>
            </form>
        </div>
    </div>
</div>
