@page "{id:int}"
@model Marketplace.Pages.Products.DetailsModel
@{
    ViewData["Title"] = Model.Product?.Name;
}

@if (Model.Product == null)
{
    <div class="alert alert-danger">Товар не найден.</div>
}
else
{
    <div class="row">
        <div class="col-md-5">
            @if (!string.IsNullOrEmpty(Model.Product.ImageUrl))
            {
                <img src="@Model.Product.ImageUrl" class="img-fluid rounded-3 w-100" alt="@Model.Product.Name" style="max-height:400px; object-fit:cover;" />
            }
            else
            {
                <div class="bg-secondary d-flex align-items-center justify-content-center rounded-3" style="height:300px;">
                    <i class="bi bi-image text-white" style="font-size:4rem;"></i>
                </div>
            }
        </div>
        <div class="col-md-7">
            <span class="badge bg-secondary mb-2">@Model.Product.Category?.Name</span>
            <h2 class="fw-bold">@Model.Product.Name</h2>
            <p class="text-muted">@Model.Product.Description</p>
            <div class="my-3">
                <span style="font-size:2rem; font-weight:700; color:#005bff;">@Model.Product.Price ₽</span>
            </div>
            <p class="text-muted">В наличии: <strong>@Model.Product.Stock шт.</strong></p>

            @if (Model.Product.Stock > 0)
            {
                <a href="/Orders/Create?productId=@Model.Product.Id" class="btn btn-primary btn-lg mt-2">
                    <i class="bi bi-cart-plus"></i> Купить
                </a>
            }
            else
            {
                <button class="btn btn-secondary btn-lg mt-2" disabled>Нет в наличии</button>
            }

            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <div class="mt-3 d-flex gap-2">
                    <a href="/Products/Edit/@Model.Product.Id" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-pencil"></i> Редактировать
                    </a>
                    <a href="/Products/Delete/@Model.Product.Id" class="btn btn-outline-danger btn-sm">
                        <i class="bi bi-trash"></i> Удалить
                    </a>
                </div>
            }
        </div>
    </div>
}
