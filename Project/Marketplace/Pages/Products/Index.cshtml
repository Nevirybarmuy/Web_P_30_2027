@page
@model Marketplace.Pages.Products.IndexModel
@{
    ViewData["Title"] = "Товары";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0" style="color: #c8a84b;">⚔️ Каталог товаров</h2>
    <a href="/Products/Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Добавить товар
    </a>
</div>

@if (!Model.Products.Any())
{
    <div class="alert alert-info">Товаров пока нет.</div>
}
else
{
    <div class="row g-3">
        @foreach (var product in Model.Products)
        {
            <div class="col-md-4">
                <div class="card h-100 p-3">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="badge bg-secondary">@product.Category?.Name</span>
                        @if (product.Price == 0)
                        {
                            <span class="badge bg-success">Бесплатно</span>
                        }
                        else
                        {
                            <span class="badge-price">@product.Price ₽</span>
                        }
                    </div>
                    <h5 class="text-white mb-1">@product.Name</h5>
                    <p class="text-muted small mb-2">@product.Description</p>
                    <p class="text-muted small mb-3">В наличии: @product.Stock шт.</p>
                    <div class="d-flex gap-2 mt-auto">
                        <a href="/Products/Details/@product.Id" class="btn btn-sm btn-outline-warning flex-grow-1">Подробнее</a>
                        <a href="/Products/Edit/@product.Id" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <a href="/Products/Delete/@product.Id" class="btn btn-sm btn-outline-danger">
                            <i class="bi bi-trash"></i>
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
