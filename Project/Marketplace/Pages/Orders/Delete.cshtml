@page "{id:int}"
@model Marketplace.Pages.Orders.DeleteModel
@{
    ViewData["Title"] = "Удалить заказ";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card p-4">
            <h3 class="fw-bold mb-3 text-danger">Удалить заказ?</h3>
            <p>Заказ от <strong>@Model.Order?.CustomerName</strong> на товар <strong>@Model.Order?.Product?.Name</strong></p>
            <form method="post">
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger">Удалить</button>
                    <a href="/Orders" class="btn btn-outline-secondary">Отмена</a>
                </div>
            </form>
        </div>
    </div>
</div>
