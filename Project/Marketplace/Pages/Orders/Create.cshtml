@page
@model Marketplace.Pages.Orders.CreateModel
@{
    ViewData["Title"] = "Оформить заказ";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card p-4">
            <h3 class="fw-bold mb-4">Оформить заказ</h3>
            <form method="post">
                <div class="mb-3">
                    <label asp-for="Order.CustomerName" class="form-label">Ваше имя *</label>
                    <input asp-for="Order.CustomerName" class="form-control" required />
                    <span asp-validation-for="Order.CustomerName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Order.CustomerEmail" class="form-label">Email *</label>
                    <input asp-for="Order.CustomerEmail" class="form-control" type="email" required />
                    <span asp-validation-for="Order.CustomerEmail" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Order.ProductId" class="form-label">Товар *</label>
                    <select asp-for="Order.ProductId" asp-items="Model.Products" class="form-select" required>
                        <option value="">— выберите —</option>
                    </select>
                    <span asp-validation-for="Order.ProductId" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Order.Quantity" class="form-label">Количество *</label>
                    <input asp-for="Order.Quantity" class="form-control" type="number" min="1" value="1" required />
                    <span asp-validation-for="Order.Quantity" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary">Оформить</button>
                    <a href="/Products" class="btn btn-outline-secondary">Отмена</a>
                </div>
            </form>
        </div>
    </div>
</div>
