@page "{id:int}"
@model Marketplace.Pages.Categories.DeleteModel
@{
    ViewData["Title"] = "Удалить категорию";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card p-4">
            <h3 class="fw-bold mb-3 text-danger">Удалить категорию?</h3>
            <p>Вы уверены, что хотите удалить <strong>@Model.Category?.Name</strong>?</p>
            <form method="post">
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger">Удалить</button>
                    <a href="/Categories" class="btn btn-outline-secondary">Отмена</a>
                </div>
            </form>
        </div>
    </div>
</div>
