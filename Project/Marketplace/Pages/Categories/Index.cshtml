@page
@model Marketplace.Pages.Categories.IndexModel
@{
    ViewData["Title"] = "Категории";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0" style="color: #c8a84b;">Категории</h2>
    <a href="/Categories/Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Добавить категорию
    </a>
</div>

@if (!Model.Categories.Any())
{
    <div class="alert alert-info">Категорий пока нет.</div>
}
else
{
    <div class="row g-3">
        @foreach (var cat in Model.Categories)
        {
            <div class="col-md-4">
                <div class="card p-3 d-flex flex-row align-items-center gap-3">
                    <i class="bi bi-tag-fill text-warning fs-4"></i>
                    <div class="flex-grow-1">
                        <strong class="text-white">@cat.Name</strong>
                        <div class="text-muted small">@(cat.Products?.Count ?? 0) товаров</div>
                    </div>
                    <a href="/Categories/Edit/@cat.Id" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-pencil"></i>
                    </a>
                    <a href="/Categories/Delete/@cat.Id" class="btn btn-sm btn-outline-danger">
                        <i class="bi bi-trash"></i>
                    </a>
                </div>
            </div>
        }
    </div>
}
