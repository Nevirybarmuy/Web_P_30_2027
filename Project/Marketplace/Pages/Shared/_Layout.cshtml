<!DOCTYPE html>
<html lang="ru" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Dota 2 Marketplace</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        :root {
            --dota-red: #c23b22;
            --dota-gold: #c8a84b;
        }
        body { font-family: 'Segoe UI', sans-serif; background: #111; }
        .navbar { background: #1a1a1a !important; border-bottom: 2px solid var(--dota-red); }
        .navbar-brand { font-weight: 900; font-size: 1.4rem; color: var(--dota-gold) !important; }
        .nav-link { color: #ccc !important; }
        .nav-link:hover { color: var(--dota-gold) !important; }
        .card { border-radius: 8px; border: 1px solid #2a2a2a; background: #1a1a1a; }
        .card:hover { border-color: var(--dota-red); }
        .btn-primary { background: var(--dota-red); border-color: var(--dota-red); }
        .btn-primary:hover { background: #a03020; border-color: #a03020; }
        .badge-price { background: var(--dota-red); color: #fff; border-radius: 4px; padding: 2px 8px; }
        footer { background: #1a1a1a; border-top: 1px solid #2a2a2a; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg mb-4">
        <div class="container">
            <a class="navbar-brand" href="/Products">⚔️ Dota 2 Marketplace</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/Products">Товары</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Categories">Категории</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Orders">Заказы</a>
                    </li>
                </ul>
                <ul class="navbar-nav align-items-center">
                    <li class="nav-item">
                        <span id="themeToggle" class="nav-link" style="cursor:pointer;">
                            <i class="bi bi-sun-fill"></i>
                        </span>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="container">
        @RenderBody()
    </main>

    <footer class="mt-5 py-3 text-center text-muted small">
        &copy; 2026 Dota 2 Marketplace
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const html = document.documentElement;
        const btn = document.getElementById('themeToggle');
        const icon = btn.querySelector('i');
        const saved = localStorage.getItem('theme') ||
            (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        setTheme(saved);
        btn.addEventListener('click', () => setTheme(html.getAttribute('data-bs-theme') === 'dark' ? 'light' : 'dark'));
        function setTheme(t) {
            html.setAttribute('data-bs-theme', t);
            localStorage.setItem('theme', t);
            icon.className = t === 'dark' ? 'bi bi-sun-fill' : 'bi bi-moon-fill';
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
