@using Marketplace.Models
@model Product

<h2>Добавление товара</h2>

<form method="post">
    <div>
        <label>Название:</label><br>
        <input asp-for="Name" required style="width: 300px;">
    </div>
    <br>
    <div>
        <label>Цена:</label><br>
        <input asp-for="Price" type="number" step="0.01" required>
    </div>
    <br>
    <div>
        <label>Количество:</label><br>
        <input asp-for="Quantity" type="number">
    </div>
    <br>
    <div>
        <label>Категория:</label><br>
        <input asp-for="Category">
    </div>
    <br>
    <div>
        <label>Описание:</label><br>
        <textarea asp-for="Description" rows="3" cols="40"></textarea>
    </div>
    <br>
    <button type="submit" style="background: green; color: white; padding: 10px;">Сохранить</button>
    <a href="/Products">Отмена</a>
</form>