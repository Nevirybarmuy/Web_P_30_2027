@using Marketplace.Models
@model IEnumerable<Product>

<h2>Управление товарами</h2>

<p>
    <a href="/Products/Create" style="background: green; color: white; padding: 10px; text-decoration: none;">+ Добавить товар</a>
</p>

<table border="1" cellpadding="10" style="width: 100%; border-collapse: collapse;">
    <tr style="background: #f0f0f0;">
        <th>ID</th>
        <th>Название</th>
        <th>Цена</th>
        <th>Категория</th>
        <th>Действия</th>
    </tr>
    @foreach (var product in Model)
    {
        <tr>
            <td>@product.Id</td>
            <td>@product.Name</td>
            <td>@product.Price.ToString("C")</td>
            <td>@product.Category</td>
            <td>
                <a href="/Products/Edit/@product.Id">✏️ Редактировать</a> |
                <a href="/Products/Delete/@product.Id" onclick="return confirm('Удалить?')">🗑️ Удалить</a>
            </td>
        </tr>
    }
</table>